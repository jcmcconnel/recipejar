#!/usr/bin/env bash
# Single developer launcher: find JDK 17+, then run Compose desktop app.
# End users should use a packaged build (Deb/MSI/DMG or createDistributable binary).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

# True if $1/bin/java reports major version >= 17.
is_jdk_17_plus() {
  local home="$1"
  [[ -x "$home/bin/java" ]] || return 1
  local v
  v="$("$home/bin/java" -version 2>&1 | head -1 || true)"
  # Matches: version "17…", "21…", "1.8" is rejected (needs 17+)
  echo "$v" | grep -qE 'version "(1[7-9]|[2-9][0-9])\.'
}

# Resolve a macOS bundle root (…/jdk-21…/Contents/Home) when given either the
# bundle or the Home directory.
normalize_java_home() {
  local d="$1"
  if [[ -x "$d/bin/java" ]]; then
    echo "$d"
  elif [[ -x "$d/Contents/Home/bin/java" ]]; then
    echo "$d/Contents/Home"
  else
    return 1
  fi
}

pick_java_home() {
  if [[ -n "${JAVA_HOME:-}" ]]; then
    local nh
    if nh="$(normalize_java_home "$JAVA_HOME")" && is_jdk_17_plus "$nh"; then
      echo "$nh"
      return 0
    fi
  fi
  local candidates=(
    "$HOME/.local/jdk/current"
    "$HOME/.local/jdk/jdk-17.0.19+10"
    "$HOME/.local/jdks/current"
    "/usr/lib/jvm/java-17-openjdk-amd64"
    "/usr/lib/jvm/java-17-openjdk"
    "/usr/lib/jvm/temurin-17-jdk-amd64"
  )
  local d nh
  for d in "${candidates[@]}"; do
    if nh="$(normalize_java_home "$d")" && is_jdk_17_plus "$nh"; then
      echo "$nh"
      return 0
    fi
  done
  # ~/.local/jdks/* (Temurin tarballs on macOS often live here)
  for d in "$HOME"/.local/jdks/jdk-* "$HOME"/.local/jdk/jdk-*; do
    [[ -e "$d" ]] || continue
    if nh="$(normalize_java_home "$d")" && is_jdk_17_plus "$nh"; then
      echo "$nh"
      return 0
    fi
  done
  # macOS java_home helper (often missing when only a user-local JDK is installed)
  if command -v /usr/libexec/java_home >/dev/null 2>&1; then
    local jh
    jh="$(/usr/libexec/java_home -v 17+ 2>/dev/null || true)"
    if [[ -n "$jh" ]] && is_jdk_17_plus "$jh"; then
      echo "$jh"
      return 0
    fi
  fi
  # Gradle-provisioned toolchain (path may vary)
  local g
  g="$(ls -d "$HOME"/.gradle/jdks/*{17,21,22,23,24}* 2>/dev/null | head -1 || true)"
  if [[ -n "$g" ]]; then
    if nh="$(normalize_java_home "$g")" && is_jdk_17_plus "$nh"; then
      echo "$nh"
      return 0
    fi
  fi
  return 1
}

# Prefer a prebuilt distributable if present (no Gradle needed).
DIST_BIN="$(ls -d "$ROOT"/composeApp/build/compose/binaries/main/app/RecipeJar/bin/RecipeJar 2>/dev/null | head -1 || true)"
if [[ -z "$DIST_BIN" ]]; then
  DIST_BIN="$(ls -d "$ROOT"/composeApp/build/compose/binaries/*/app/*/bin/RecipeJar 2>/dev/null | head -1 || true)"
fi
if [[ -n "$DIST_BIN" && -x "$DIST_BIN" ]]; then
  exec "$DIST_BIN" "$@"
fi

if ! JH="$(pick_java_home)"; then
  echo "RecipeJar needs JDK 17+." >&2
  echo "Install Temurin/OpenJDK 17, or set JAVA_HOME to a JDK 17 install." >&2
  echo "Alternatively build a packaged app: ./gradlew :composeApp:createDistributable" >&2
  exit 1
fi

export JAVA_HOME="$JH"
export PATH="$JAVA_HOME/bin:$PATH"
echo "Using JAVA_HOME=$JAVA_HOME"
exec ./gradlew :composeApp:run "$@"
